# Segredos DESCARTAVEIS do stack local de verificacao (docker-compose.local.yml).
# NUNCA reutilize valores de homologacao/producao aqui, e NUNCA commite o .env.local.
DB_PASS=localtest_db_pass
RABBITMQ_USER=watink
RABBITMQ_PASS=localtest_mq_pass
JWT_SECRET=localtest_jwt_secret_0123456789
JWT_REFRESH_SECRET=localtest_refresh_secret_0123456789
PROXY_ENC_KEY=0123456789abcdef0123456789abcdef
INTERNAL_TOKEN=localtest_internal_token
GROUPS_API_TOKEN=localtest_groups_token
PORT=8082
# Postgres, business e engine sao CONSTRUIDOS deste checkout (docker-compose.local.yml); IMAGE_TAG so satisfaz o compose base.
IMAGE_TAG=local
DB_LOG_LEVEL=warn
