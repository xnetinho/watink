# ─── Watink Production Environment ───
# Usado pelo docker-compose.yml (distribuição via Docker Hub, imagens
# ronaldodavi/watink-*). Copie e preencha com segredos REAIS antes de subir:
#   cp .env.production.example .env
#
# Gere cada segredo com: openssl rand -hex 32
# NUNCA reuse os valores de exemplo do .env.example (esse é só para
# docker-compose.dev.yml / desenvolvimento local).

# ─── Imagem ───
# Tag publicada por .github/workflows/publish-dockerhub.yml:
#   latest  → último push em main (estável)
#   develop → último push em develop (homologação)
#   sha-<hash> → build de um commit específico
IMAGE_TAG=latest

# ─── Porta pública (host) ───
PORT=80

# ─── Database ───
DB_PASS=

# ─── RabbitMQ ───
RABBITMQ_USER=watink
RABBITMQ_PASS=

# ─── Auth ───
JWT_SECRET=
JWT_REFRESH_SECRET=

# ─── Criptografia at-rest (senhas de proxy) ───
PROXY_ENC_KEY=

# ─── Token interno (business ↔ plugin-manager local, stats de instância) ───
PLUGIN_MANAGER_INTERNAL_TOKEN=

# ─── Endereço do engine (só rede interna) ───
# No serviço do business, defina ENGINE_HOST com o nome do engine na rede (ex.: watink-engine).
# Daí saem /health (8083), grupos (8084) e áudio das chamadas (8085). As portas do engine nunca
# podem ser publicadas em `ports:`.

# ─── Armazenamento de objetos S3 (gravações de chamadas, Base de Conhecimento, fotos de atividades) ───
# Qualquer serviço S3-compatível serve (MinIO, AWS, Backblaze B2, Cloudflare R2). Sem S3_ENDPOINT o
# armazenamento fica desligado. Exemplo Backblaze B2 (crie o bucket PRIVADO antes e uma chave de
# aplicação restrita a ele; o endpoint é só o host, sem https://):
#   S3_ENDPOINT=s3.us-west-004.backblazeb2.com
#   S3_REGION=us-west-004
#   S3_BUCKET=meu-bucket
#   S3_ACCESS_KEY=<keyID>
#   S3_SECRET_KEY=<applicationKey>
#   S3_USE_SSL=true
